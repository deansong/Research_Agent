{
  "schema_version": 1,
  "taxonomy_id": "hotel-skill-vocabulary-v1",
  "frozen_on": "2026-09-08",
  "development_rule": "Vocabulary and aliases were defined before any model scoring, from broad functional coverage in ESCO 1.2.0 and hotel-role boundaries in the frozen role map. Model outputs and reserved O*NET validation ratings were not used.",
  "source": {
    "title": "European Skills, Competences, Qualifications and Occupations classification",
    "publisher": "European Commission, DG Employment, Social Affairs and Inclusion",
    "version": "1.2.0",
    "release_date": "2024-05",
    "accessed_on": "2026-09-08",
    "url": "https://esco.ec.europa.eu/en/use-esco/download",
    "archive_sha256": "49526f51ea5a26126c866e010c5552e1af084ed3eb5a53e1a3602bc06957d66d",
    "use": "independent domain and terminology source; the scored phrases are researcher-frozen English labels, not a claim that each is an exact ESCO preferred label"
  },
  "inclusion_rules": [
    "Include interpretable English skill or knowledge phrases that can plausibly vary in association across at least two frozen hotel roles.",
    "Cover interpersonal, administrative, commercial, digital, environmental, safety, operational and supervisory domains.",
    "Retain both one-word and multiword surfaces so total and mean-token scoring sensitivities are identifiable.",
    "Use one canonical phrase per concept; aliases are for display/mapping only and are never scored as extra observations in the primary taxonomy.",
    "Freeze without consulting model logits, generations, ranks or reserved validation ratings."
  ],
  "exclusion_rules": [
    "Exclude personality traits, protected characteristics, credentials, educational attainment, wages, availability and years of experience.",
    "Exclude vendor brands from the primary vocabulary; software-brand phrases belong only in a future technology sensitivity.",
    "Exclude phrases that encode a specific region, employer, hotel tier or legal regime.",
    "Exclude synonyms as separate primary skills and exclude model-discovered phrases until a newly digested design is reviewed."
  ],
  "token_length_policy": {
    "surface_classes": {"single_word": "one whitespace-delimited word", "multiword": "two or more whitespace-delimited words"},
    "model_token_class": "At tokenizer qualification, render the exact target boundary and record token IDs and counts separately for each pinned tokenizer revision. Do not infer token counts from whitespace.",
    "unresolved_status": "required_preflight_cell; gated tokenizer access was not assumed during this freeze"
  },
